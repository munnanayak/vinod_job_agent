{
  "manifest_version": 3,
  "name": "Job Agent \u2014 Form Assistant",
  "version": "0.17.0",
  "description": "Fills approved job applications opened from your Job Agent dashboard. You review and submit.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://vinod-job-agent.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["fill.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fill an approved application"
  }
}
