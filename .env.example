DATABASE_URL=postgresql://jobagent:jobagent@127.0.0.1:5432/jobagent
# Optional direct connection for migrations when DATABASE_URL uses pooling.
DIRECT_URL=
API_PORT=3000
# Render supplies PORT and RENDER_EXTERNAL_HOSTNAME automatically.
# Set API_PUBLIC_URL only for an additional backend custom domain.
API_PUBLIC_URL=
APP_URL=http://localhost:5173
# Frontend build only: backend origin, without /api; empty uses the Vite proxy.
VITE_API_BASE_URL=

# Fuelix (OpenAI-compatible) for match explanations
FUELIX_API_KEY=
FUELIX_BASE_URL=https://api.fuelix.ai/v1
FUELIX_CHAT_MODEL=gpt-5-mini

# Google OAuth client (Web application) with this exact redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Jobs
# 64 hex chars: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Official company job boards to scan (greenhouse:<board> or lever:<site>, optional =Company Name)
JOB_BOARDS=greenhouse:gitlab=GitLab,lever:paytm=Paytm
DISCOVERY_LIMIT=60

# Autopilot
# Legacy setting: email still requires sheet approval + Preview + Publish.
AUTO_SEND=false
AUTO_SEND_MIN_SCORE=60
AUTO_SEND_DAILY_CAP=20
AUTO_RUN_HOURS=6
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Discovery: worldwide includes relocation leads; application checks still use your profile.
DISCOVERY_LOCATION_SCOPE=worldwide
# junior-mid or all; target titles always come from your saved profile.
JOB_SENIORITY=junior-mid
# all = 19 configured Adzuna markets, or a comma-separated subset (in,us,gb,...).
ADZUNA_COUNTRIES=all
ADZUNA_PAGES=2
ADZUNA_REQUESTS_PER_RUN=18
# Optional Google Jobs discovery via SerpApi (separate from Gmail OAuth).
SERPAPI_API_KEY=
GOOGLE_JOBS_COUNTRIES=in,us,gb,ca,au,de,sg,ae
GOOGLE_JOBS_REQUESTS_PER_RUN=4
GOOGLE_JOBS_MONTHLY_LIMIT=100
# Web searches (same SerpApi key) to find company websites and their published hiring mailbox
# Application batches are capped at 10 per dashboard click.
COMPANY_SEARCHES_PER_RUN=25
COMPANY_SEARCHES_MONTHLY_LIMIT=140
# Set false only when another scheduler invokes discovery.
SCHEDULER_ENABLED=true

# Maximum minimum experience required by a job; unknown requirements stay reviewable.
JOB_MAX_EXPERIENCE_YEARS=3
